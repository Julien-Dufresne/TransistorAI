MDURATION( Abrechnung; Fälligkeit; Kupon; Rendite; Häufigkeit; [Basis=0])
MDURATION("01.02.2004 ";" 31.05.2004 "; 0,08; 0,09; 2; 0) ergibt 0,316321106
